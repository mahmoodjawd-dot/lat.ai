{
  "manifest_version": 3,
  "name": "Cursor Agent",
  "version": "0.2.0",
  "description": "A second cursor on every page with an AI agent inside. Press ctrl + option and ask it anything.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Cursor Agent (ctrl + option)",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "commands": {
    "toggle-agent": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Open or close Cursor Agent on this page"
    }
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["cursor-agent.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
